# Copy this file to .env.local and fill in the values.
# Every key is optional: without it the matching feature runs in preview mode.

# MongoDB Atlas connection string (Database > Connect > Drivers).
# Without it, photos and try-on results are kept in server memory for local dev only.
MONGODB_URI=
MONGODB_DB=mira

# Anthropic Claude - powers the photo check, fit explanation and AI stylist.
# Get it at console.anthropic.com > API Keys.
ANTHROPIC_API_KEY=
# Default is claude-opus-5. claude-sonnet-5 is the cheaper option for the $5 pilot.
CLAUDE_MODEL=claude-sonnet-5

# Google AI Studio - Nano Banana (gemini-2.5-flash-image) renders the virtual try-on.
# Get it at aistudio.google.com > Get API key. Paid tier needs billing linked.
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Public site URL, used for share links (set on Vercel to the deployed domain).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
